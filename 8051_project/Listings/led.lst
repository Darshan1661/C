A51 MACRO ASSEMBLER  LED                                                                  11/30/2025 12:59:25 PAGE     1


MACRO ASSEMBLER A51 V8.2.7.0
OBJECT MODULE PLACED IN .\Objects\led.obj
ASSEMBLER INVOKED BY: C:\Keil_v5\C51\BIN\A51.EXE led.a51 SET(SMALL) DEBUG PRINT(.\Listings\led.lst) OBJECT(.\Objects\led
                      .obj) EP

LOC  OBJ            LINE     SOURCE

0000                   1             ORG 0000H          ; Reset vector
0000 020030            2             LJMP MAIN          ; Jump to main program
                       3     
                       4     ;---------------------------------------------------
                       5     ; Interrupt Vector Table
                       6     ;---------------------------------------------------
0003                   7             ORG 0003H          ; External Interrupt 0 vector address
0003 020048            8             LJMP EX0_ISR       ; Jump to External INT0 ISR
                       9     
                      10     ;---------------------------------------------------
                      11     ; Bit flag in bit-addressable RAM
                      12     ; TOGFLAG = 0 ? normal (P2 = P1)
                      13     ; TOGFLAG = 1 ? inverted (P2 = ~P1)
                      14     ;---------------------------------------------------
  0020                15     TOGFLAG BIT 20H            ; Use bit-addressable RAM location 20H
                      16     
                      17     ;---------------------------------------------------
                      18     ; Main Program
                      19     ;---------------------------------------------------
0030                  20             ORG 0030H
0030                  21     MAIN:
0030 7590FF           22             MOV P1, #0FFH      ; Port 1 as INPUT (switches)
0033 75A000           23             MOV P2, #00H       ; Port 2 as OUTPUT (LEDs initially OFF)
                      24     
0036 C220             25             CLR TOGFLAG        ; Start with normal display (no invert)
                      26     
0038 75A881           27             MOV IE, #81H       ; EA=1 (global enable), EX0=1 (enable INT0)
003B 758801           28             MOV TCON, #01H     ; IT0=1 (edge trigger on INT0), IE0=0
                      29     
003E                  30     MAIN_LOOP:
003E E590             31             MOV A, P1          ; Read switches from Port 1
                      32     
0040 302001           33             JNB TOGFLAG, NO_INVERT  ; If TOGFLAG = 0, skip inversion
0043 F4               34             CPL A              ; If TOGFLAG = 1 ? invert whole pattern
0044                  35     NO_INVERT:
0044 F5A0             36             MOV P2, A          ; Output pattern on Port 2 LEDs
                      37     
0046 80F6             38             SJMP MAIN_LOOP     ; Repeat forever
                      39     
                      40     ;---------------------------------------------------
                      41     ; External Interrupt 0 ISR (INT0 - P3.2)
                      42     ;---------------------------------------------------
0048                  43     EX0_ISR:
0048 B220             44             CPL TOGFLAG        ; Toggle flag on every button press
004A 32               45             RETI               ; Return from interrupt
                      46     
                      47             END
A51 MACRO ASSEMBLER  LED                                                                  11/30/2025 12:59:25 PAGE     2

